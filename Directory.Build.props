<Project>
    <!-- TC hygiene — MUST be duplicated here. This file SHADOWS TC_forward/Directory.Build.props
         (MSBuild imports only the nearest one), so without these lines the plugin ships with
         absolute local paths baked in: every [CallerFilePath] default argument becomes a string
         literal in the DLL, and the SDK's SourceLink/SCM queries embed the outer repo URL + SHA.
         Measured 2026-08-01 on the published v15.306.1.19-TC13 build: 31 distinct build-machine
         path strings in Questionable.dll, plus a SourceLink blob and a username in the PDB.
         Keep in sync with TC_forward/Directory.Build.props. -->
    <PropertyGroup>
        <Deterministic>true</Deterministic>
        <PathMap>$(MSBuildThisFileDirectory)=/</PathMap>
        <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
        <EnableSourceLink>false</EnableSourceLink>
        <!-- GitInfo runs git on the enclosing repo independently of SourceLink; see TC_forward/Directory.Build.props -->
        <GitThisAssembly>false</GitThisAssembly>
    </PropertyGroup>

    <ItemGroup>
        <!--
            MA0003 — "Add parameter name to improve readability".
            Lightly enforce named arguments for boolean and null literals
            (configured in .editorconfig). Analyzer-only, no runtime cost.
        -->
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.122"
                         PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>
</Project>
